# Copiar este archivo como .env.local y completar con los datos del proyecto Supabase.
# .env.local está en .gitignore: nunca se sube al repositorio.

# URL del proyecto (en desarrollo local, la que muestra `supabase start`).
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Clave PÚBLICA (publishable / anon). Es la única que puede ir en el navegador.
# NUNCA poner acá la service_role ni una clave secreta (sb_secret_...):
# la app se niega a arrancar si detecta una.
VITE_SUPABASE_PUBLISHABLE_KEY=
