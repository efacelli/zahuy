# Secretos de la función de PRUEBA de ARCA (HOMOLOGACIÓN). Esto es solo una plantilla:
# copiá este archivo a `.env` (ignorado por Git) y completalo en tu computadora.
# NUNCA pegues acá ni subas un certificado, una clave privada ni un CUIT reales.
ARCA_CUIT=
# Certificado de HOMOLOGACIÓN en PEM, en una sola línea con \n literales
ARCA_CERT_PEM=
# Clave privada con la que generaste el CSR, en una sola línea con \n literales
ARCA_KEY_PEM=
# Punto de venta de homologación habilitado para WSFEv1
ARCA_PTO_VTA=1
# 1 = Factura A, 6 = Factura B, 11 = Factura C
ARCA_CBTE_TIPO=6
# sha256 (por defecto) o sha1, la que nombra la especificación del WSAA
ARCA_DIGEST=sha256
